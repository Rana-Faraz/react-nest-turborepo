{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "router:generate": "tsr generate",
    "build": "pnpm router:generate && vite build && pnpm check-types:source",
    "check-types": "pnpm router:generate && pnpm check-types:source",
    "check-types:source": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "knip": "pnpm --dir ../.. exec knip --workspace web",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"vite.config.ts\" --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.ts\" \"**/*.tsx\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-router": "^1.170.32",
    "axios": "^1.20.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
