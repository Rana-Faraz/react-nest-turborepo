{
  "name": "backend",
  "version": "0.0.1",
  "description": "Tournament backend",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "knip": "pnpm --dir ../.. exec knip --workspace backend",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/datasource.config.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/datasource.config.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/datasource.config.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/datasource.config.ts",
    "start": "nest start",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hedystia/better-auth-typeorm": "^1.1.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.0",
    "@repo/contracts": "workspace:*",
    "@repo/jobs": "workspace:*",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "eslint": "^10.9.1",
    "knip": "^6.32.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
