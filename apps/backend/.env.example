# Application
NODE_ENV=development
PORT=3000
APP_NAME="eSIM Business"
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=esim
DB_PASSWORD=esim_local
