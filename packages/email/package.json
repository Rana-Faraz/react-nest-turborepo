{
  "name": "@repo/emails",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "email dev -p 3001",
    "export": "email export",
    "knip": "pnpm --dir ../.. exec knip --workspace @repo/emails",
    "lint": "eslint \"emails/**/*.tsx\" \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "start": "email start -p 3001"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "6.9.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^10.9.1",
    "knip": "^6.32.3",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
